{
  "name": "@willow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:function": "esbuild src/function.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/function.mjs --alias:pg-native=./scripts/pg-native-stub.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "vapid": "node scripts/generate-vapid.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@hono/node-server": "^2.1.1",
    "@neon/functions": "^0.8.0",
    "@types/ws": "^8.18.1",
    "@willow/shared": "*",
    "better-auth": "^1.3.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.0",
    "openai": "^5.8.1",
    "pg": "^8.13.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.4",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
