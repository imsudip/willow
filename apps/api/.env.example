# OpenAI API key. Never exposed to the client — the API proxies everything.
OPENAI_API_KEY=

# Postgres (Neon). Injected automatically on Neon Functions; for local dev
# run `neon env pull` (writes .env.local) or paste the pooled URL here.
# DATABASE_URL=

# Cloudflare R2 (audio storage). Create an R2 API token (Object Read & Write)
# at dash.cloudflare.com → R2 → Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Cloudflare API token with R2 read permission (used for the free-tier usage gate).
R2_API_TOKEN=
R2_BUCKET=willow-audio

# Free-tier guardrails
# R2_STORAGE_LIMIT_BYTES=9900000000   # 9.9 GB
# MAX_UPLOADS_PER_USER_PER_DAY=50

# Shared secret that GitHub Actions sends to /api/cron/* endpoints.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Better Auth secret. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional overrides
# TRANSCRIPTION_MODEL=gpt-live-transcribe
# CLEANUP_MODEL=gpt-4o-mini

# Web push (generate with: npm run vapid -w @willow/api). Without these, reminders are disabled.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Your deployed origin (e.g. https://willow.vercel.app). Sets auth cookies + trusted origins.
# PUBLIC_ORIGIN=
