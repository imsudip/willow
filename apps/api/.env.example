# OpenAI API key. Never exposed to the client — the API proxies everything.
OPENAI_API_KEY=

# Optional overrides
# TRANSCRIPTION_MODEL=gpt-live-transcribe
# CLEANUP_MODEL=gpt-4o-mini

# Web push (generate with: npm run vapid -w @willow/api). Without these, reminders are disabled.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Evening reminder (default 18:30)
# REMINDER_CRON=30 18 * * *

# Where SQLite + audio live
# DATA_DIR=./data
# PORT=8777
