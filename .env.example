# ═══════════════════════════════════════════════════════════════════════════
#  Willow — single environment template
#
#  Copy this file to `.env.local` at the REPO ROOT and fill in your values:
#
#      cp .env.example .env.local
#
#  One file serves EVERY service:
#    • apps/web — the Next.js app reads it in dev (src/lib/env-load.ts);
#                 in prod the same values are set as Vercel project env vars
#    • GitHub Actions — scripts/push-secrets-to-github.sh pushes them
#
#  NEVER commit .env.local. It is gitignored.
#
#  Legend:  [web] Next.js runtime  [gh] GitHub Actions  [vercel] Vercel project
#           [db] database
#
#  💡 Step-by-step "where to get each secret" guide:
#     docs/environment-secrets.md
# ═══════════════════════════════════════════════════════════════════════════

# ── OpenAI (transcription + AI features) ─────────────────────────────────────
# [web] [gh]  Required for transcription. Server-side only — never shipped to
# the client. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# [web] Model for audio transcription. Default: gpt-4o-mini-transcribe
# TRANSCRIPTION_MODEL=

# [web] Model for cleanup/prompts/digest. Default: gpt-4o-mini
# CLEANUP_MODEL=

# ── Database — Neon Postgres ─────────────────────────────────────────────────
# [db] [web] [gh] Pooled connection string (the Next.js app + drizzle-kit
# migrations use it). In prod it's set as a Vercel project env var and a
# GitHub secret for the deploy pipeline's migrate step.
# DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/willow

# ── Cloudflare R2 (audio storage + presigned URLs) ───────────────────────────
# [web] [gh] R2 S3 API token with "Object Read & Write" permission.
# Create at dash.cloudflare.com → R2 → Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# [web] [gh] Cloudflare API token with R2 read permission. Used for the
# free-tier usage gate (checks bucket size before minting upload URLs).
R2_API_TOKEN=

# [web] [gh] R2 bucket name. Default: willow-audio
# R2_BUCKET=willow-audio

# Free-tier guardrails (all optional, defaults shown):
# [web] Reject new uploads once bucket usage passes this (default 9.9 GB)
# R2_STORAGE_LIMIT_BYTES=9900000000
# [web] Per-user daily upload cap (default 50)
# MAX_UPLOADS_PER_USER_PER_DAY=50
# [web] Per-recording cap, enforced via presigned PUT Content-Length
# (default 10 MB = ~10 min of WebM speech)
# MAX_AUDIO_UPLOAD_BYTES=10485760

# ── Auth ─────────────────────────────────────────────────────────────────────
# [web] [gh] Better Auth session secret. REQUIRED (no default).
# Generate with:  openssl rand -hex 32
AUTH_SECRET=

# ── Web push (optional — without these, reminders/digests are disabled) ──────
# [web] [gh] Generate with:  node apps/web/scripts/generate-vapid.mjs
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# [web] Web-push public key baked into the client bundle (public — safe to
# expose). Next.js only exposes NEXT_PUBLIC_* vars to the browser.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── App origin & timezone ────────────────────────────────────────────────────
# [web] [gh] Your deployed origin. Drives Better Auth's baseURL.
# e.g. https://willow.vercel.app
# PUBLIC_ORIGIN=https://your-app.vercel.app

# [web] [gh] IANA timezone for the reminder's "today" boundary. Must
# match the schedules in .github/workflows/cron.yml. Default: Asia/Kolkata
# CRON_TIMEZONE=Asia/Kolkata

# [web] Reminder schedule (cron). Default: "30 18 * * *"
# REMINDER_CRON=30 18 * * *

# ── Cron auth ────────────────────────────────────────────────────────────────
# [gh] [web] Shared secret GitHub Actions sends to /api/cron/* endpoints
# (served by the Next.js app on Vercel). REQUIRED (no default).
# Generate with:  openssl rand -hex 32
CRON_SECRET=

# ── Vercel (deploy target) ───────────────────────────────────────────────────
# [vercel] [gh] Set in the Vercel project (Dashboard → Project → Settings →
# Environment Variables) OR in this file for local dev. The deploy pipeline
# needs these (set via gh / the script):
# [gh] VERCEL_ORG_ID / VERCEL_PROJECT_ID — from the Vercel project settings
# [gh] VERCEL_TOKEN — CI token from the Vercel Tokens page (or `vercel tokens add "<name>"`)
# [gh] WILLOW_API_URL — the Vercel production URL (e.g. https://willow-alpha-one.vercel.app)
#      used by cron.yml to hit /api/cron/*. The Next app serves these itself;
#      there is no separate API host.
# [gh] WILLOW_PRODUCTION_URL — the Vercel production URL (smoke-test target)

# ── Local-only / misc ────────────────────────────────────────────────────────
# [api] Where local audio/data lives. Default: ./data
# DATA_DIR=./data
# [api] Local HTTP port. Default: 8777
# PORT=8777
# [api] Where the bundled drizzle/ folder lives on the function runtime.
# Default: ./drizzle
# MIGRATIONS_DIR=./drizzle
