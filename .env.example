# ═══════════════════════════════════════════════════════════════════════════
#  Willow — single environment template
#
#  Copy this file to `.env.local` at the REPO ROOT and fill in your values:
#
#      cp .env.example .env.local
#
#  One file serves EVERY service:
#    • apps/api  — the Hono runtime reads it (src/env-load.ts)
#    • apps/web  — Vite build reads VITE_* vars from it
#    • Neon Functions — the deploy script sends these as the runtime env
#    • GitHub Actions — scripts/push-secrets-to-github.sh pushes them
#    • Vercel — the same values are set in the Vercel project dashboard
#
#  NEVER commit .env.local. It is gitignored.
#
#  Legend:  [api] runtime  [neon] deploy/function  [gh] GitHub Actions
#           [web] Vite build  [vercel] Vercel project  [db] database
# ═══════════════════════════════════════════════════════════════════════════

# ── OpenAI (transcription + AI features) ─────────────────────────────────────
# [api] [neon] [gh]  Required for transcription. Server-side only — never
# shipped to the client. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# [api] [neon] Model for audio transcription. Default: gpt-live-transcribe
# TRANSCRIPTION_MODEL=

# [api] [neon] Model for cleanup/prompts/digest. Default: gpt-4o-mini
# CLEANUP_MODEL=

# ── Database — Neon Postgres ─────────────────────────────────────────────────
# [db] [api] Pooled connection string.
#   • Neon Functions: injected automatically — you do NOT need to set this.
#   • Local dev:       run `neon env pull` (writes .env.local) or paste the
#                      pooled URL here.
# DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/willow

# ── Cloudflare R2 (audio storage + presigned URLs) ───────────────────────────
# [api] [neon] [gh] R2 S3 API token with "Object Read & Write" permission.
# Create at dash.cloudflare.com → R2 → Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# [api] [neon] [gh] Cloudflare API token with R2 read permission. Used for the
# free-tier usage gate (checks bucket size before minting upload URLs).
R2_API_TOKEN=

# [api] [neon] [gh] R2 bucket name. Default: willow-audio
# R2_BUCKET=willow-audio

# Free-tier guardrails (all optional, defaults shown):
# [api] [neon] Reject new uploads once bucket usage passes this (default 9.9 GB)
# R2_STORAGE_LIMIT_BYTES=9900000000
# [api] [neon] Per-user daily upload cap (default 50)
# MAX_UPLOADS_PER_USER_PER_DAY=50
# [api] [neon] Per-recording cap, enforced via presigned PUT Content-Length
# (default 10 MB = ~10 min of WebM speech)
# MAX_AUDIO_UPLOAD_BYTES=10485760

# ── Auth ─────────────────────────────────────────────────────────────────────
# [api] [neon] [gh] Better Auth session secret. REQUIRED (no default).
# Generate with:  openssl rand -hex 32
AUTH_SECRET=

# ── Web push (optional — without these, reminders/digests are disabled) ──────
# [api] [neon] [gh] Generate with:  npm run vapid -w @willow/api
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ── App origin & timezone ────────────────────────────────────────────────────
# [api] [neon] [gh] Your deployed origin. Sets auth cookie scope + CORS.
# e.g. https://willow.vercel.app
# PUBLIC_ORIGIN=https://your-app.vercel.app

# [api] [neon] [gh] IANA timezone for the reminder's "today" boundary. Must
# match the schedules in .github/workflows/cron.yml. Default: Asia/Kolkata
# CRON_TIMEZONE=Asia/Kolkata

# [api] Reminder schedule (cron). Default: "30 18 * * *"
# REMINDER_CRON=30 18 * * *

# ── Cron auth ────────────────────────────────────────────────────────────────
# [gh] [neon] Shared secret GitHub Actions sends to /api/cron/* endpoints.
# REQUIRED (no default). Generate with:  openssl rand -hex 32
CRON_SECRET=

# ── Neon (deploy target) ─────────────────────────────────────────────────────
# [neon] [gh] Find these in the Neon console, or via the CLI:
#   neon project list    → project ID
#   neon branch list     → branch ID
#   neon functions list  → function slug
# NEON_PROJECT_ID=
# NEON_BRANCH_ID=
# NEON_FUNCTION_SLUG=

# [neon] [gh] Neon API key for deploys. Create at console.neon.tech → Account
# → API Keys.  (Secret — never commit.)
# NEON_API_KEY=

# ── Vercel (deploy target) ───────────────────────────────────────────────────
# [vercel] [gh] Set in the Vercel project (Dashboard → Project → Settings →
# Environment Variables), NOT in this file (they're project-level):
#   WILLOW_API_URL       — Neon function URL the edge middleware proxies /api/*
#                          to, e.g. https://<branch>-<slug>.compute.c-5.us-east-2.aws.neon.tech
#   VITE_VAPID_PUBLIC_KEY — web-push public key for the built PWA
# The deploy workflow needs (set via gh / the script):
# [gh] VERCEL_ORG_ID / VERCEL_PROJECT_ID — from the Vercel project settings
# [gh] VERCEL_TOKEN — CI token from `vercel tokens create`

# ── Web (Vite build-time) ────────────────────────────────────────────────────
# [web] Vite exposes VITE_* vars to the client. Only NON-secret values!
# VITE_VAPID_PUBLIC_KEY=

# ── Local-only / misc ────────────────────────────────────────────────────────
# [api] Where local audio/data lives. Default: ./data
# DATA_DIR=./data
# [api] Local HTTP port. Default: 8777
# PORT=8777
# [api] Where the bundled drizzle/ folder lives on the function runtime.
# Default: ./drizzle
# MIGRATIONS_DIR=./drizzle
